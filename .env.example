# Copy to .env.local and fill in. .env.local is gitignored.

# --- Spotify (required) -----------------------------------------------------
# 1. https://developer.spotify.com/dashboard -> Create app
# 2. Redirect URI must be EXACTLY:  http://127.0.0.1:3000/auth/callback
#    Spotify REJECTS "localhost" — you must use the 127.0.0.1 form, and you
#    must open the app at http://127.0.0.1:3000 in your browser too.
# 3. Check "Web API" under which APIs you plan to use.
# 4. Settings -> copy the Client ID and reveal the Client secret.
#
# While the app is in development mode Spotify caps you at 25 users, and each
# one must be added by hand under Settings -> User Management.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Session (required) -----------------------------------------------------
# Signs the session cookie that holds your Spotify tokens. Any random string
# of 32+ characters. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- YouTube (optional, needed for the YouTube source in Phase 4) -----------
# Google Cloud console -> enable "YouTube Data API v3" -> create an API key.
# Default quota is 10,000 units/day; playlistItems.list costs 1 per call.
YOUTUBE_API_KEY=

# --- Supabase (optional, not wired up yet) ----------------------------------
# Leave blank for now. Auth currently runs on the signed session cookie above.
# When you're ready: create a project, run supabase/migrations/, and fill these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
